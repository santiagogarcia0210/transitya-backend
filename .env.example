# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_SA=                    # JSON de service account (minificado, sin saltos de línea)
FIREBASE_STORAGE_BUCKET=        # ej: gestion-transporte-ef756.appspot.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=                   # separar por comas: https://app.transitya.com,https://www.transitya.com

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=                # token de acceso de Mercado Pago

# ── Frontend URL (para back_urls de MP) ───────────────────────────────────────
FRONTEND_URL=                   # ej: https://app.transitya.com

# ── Mailer ────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=

# ── Anthropic (módulo IA) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── ARCA / AfipSDK ────────────────────────────────────────────────────────────
AFIPSDK_ACCESS_TOKEN=           # token de la plataforma AfipSDK (app.afipsdk.com → tu cuenta)
# Clave AES-256-GCM: 64 caracteres hexadecimales (= 32 bytes). Se decodifica como hex, no como UTF-8.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=                 # 64 chars hex, sin espacios ni comillas

# ── Correo de la empresa (lectura IMAP) ───────────────────────────────────────
# Cada empresa conecta su casilla desde la app; acá solo se configura el comportamiento.
CORREO_SYNC_MINUTOS=10          # cada cuánto se leen las casillas (0 = apagado)
CORREO_MODELO=                  # opcional: modelo de Claude para clasificar (default claude-haiku-4-5-20251001)
